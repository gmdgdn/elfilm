# ElFilm API Environment Configuration

# Development settings
ENVIRONMENT=development
API_VERSION=v1
MAX_PAGE_SIZE=100

# AI Features
ENABLE_AI=true

# Database
DATABASE_URL=d1

# Storage
R2_BUCKET_POSTERS=elfilm-posters
R2_BUCKET_IMAGES=elfilm-images

# API Settings
CORS_ORIGIN=*
REQUEST_TIMEOUT_MS=30000

# Logging
LOG_LEVEL=info

# Feature Flags
ENABLE_RECOMMENDATIONS=true
ENABLE_SEARCH_SUGGESTIONS=true
ENABLE_ANALYTICS=true

# Analytics
ANALYTICS_RETENTION_DAYS=90

# Rate Limiting (per minute)
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=60000
